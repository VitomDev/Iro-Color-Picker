#include <windows.h>
#include "resource.h"
#include "../version.h"

IDI_IRO ICON "../../assets/iro.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Iro.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION IRO_VERSION_MAJOR, IRO_VERSION_MINOR, IRO_VERSION_PATCH, 0
PRODUCTVERSION IRO_VERSION_MAJOR, IRO_VERSION_MINOR, IRO_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "VitomDev"
            VALUE "FileDescription", "Iro Color Picker"
            VALUE "FileVersion", IRO_VERSION_STRING
            VALUE "InternalName", "Iro"
            VALUE "LegalCopyright", "Copyright (c) 2026 VitomDev. MIT License."
            VALUE "OriginalFilename", "Iro.exe"
            VALUE "ProductName", "Iro Color Picker"
            VALUE "ProductVersion", IRO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
